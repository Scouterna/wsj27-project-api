# Secrets — must never enter the image.
# Patterns are anchored at the build context root, so the leading **/ is what
# actually excludes src/.env; a bare ".env" would only match one at the root.
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key
**/dev-roles.json
cmt-roles.csv

# Participant data: the dev cache is only for running the decoder offline and
# holds personal id numbers and health answers. It sits under src/, which the
# Dockerfile copies wholesale, so it has to be excluded explicitly.
src/.dev_cache/

# Local tooling and build artefacts
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.git/
.gitignore
.vscode/
k8s/
README.md
docs/
tools/
