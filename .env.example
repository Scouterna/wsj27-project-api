# Copy to .env for local development. Not used in the container image —
# there config comes from the k8s ConfigMap/Secret (see Dockerfile).

# --- Scoutnet ---
SCOUTNET_PROJECTS=[]

# Serve Scoutnet responses from .dev_cache/ instead of calling Scoutnet, for a
# fast startup. Delete .dev_cache/ to refetch. Local development only — unset
# (the default) everywhere else.
# SCOUTNET_DEV_CACHE=true

# --- Database ---
# Optional. Leave empty/unset to run without a database: the app still starts,
# but the /cases endpoints are not registered. Everything else works.
POSTGRES_DSN=postgresql://user:password@localhost:5432/wsj27

# --- Serving ---
# PORT=8000
# DEBUG=true
# Serve /docs, /redoc and /openapi.json. Off by default, as in prod.
API_DOCS=true
# INSECURE_COOKIES=true

# --- Auth ---
# Bypass JWT validation entirely and use a fake static user (see authenctication.py).
# Tune member_no/roles below to exercise different API behaviours locally.
AUTH_DISABLED=true
FAKE_USER_PREFERRED_USERNAME=1234567@scoutnet
FAKE_USER_ROLES=["wsj27:CMT:Admin"]

# --- Metrics ---
# How long a user should be considered active after calling a API
# ACTIVE_USER_TIMEOUT_SECONDS: int = 600
